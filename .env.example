# ---- TatkalX configuration (copy to .env; never commit real secrets) ----
APP_ENV=development
ENABLE_DEV_ENDPOINTS=true
ADMIN_TOKEN=change-me-admin-token

# PostgreSQL (authoritative store) and Redis (coordination, rate limiting, cache)
POSTGRES_USER=tatkalx
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=tatkalx
DATABASE_URL=postgresql+asyncpg://tatkalx:change-me-db-password@127.0.0.1:5432/tatkalx
REDIS_URL=redis://127.0.0.1:6379/0

# Coordination: redis_lock (Redis lock + DB atomic claim) or db_only (DB atomic claim only)
COORDINATION_MODE=redis_lock
LOCK_TTL_MS=5000
LOCK_WAIT_MS=300
REDIS_FAILURE_POLICY=fail_open

# Rate limiting. TEST MODE raises only the per-IP ceiling so a 500-request benchmark from one
# machine is not treated as one abusive client. Per-user limits stay enforced.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_USER=20
RATE_LIMIT_PER_IP=120
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_TEST_MODE=false

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
NUM_SHARDS=3
LOAD_BALANCER_URL=http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
